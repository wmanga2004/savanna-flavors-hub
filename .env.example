VITE_SQUARE_LOCATION_ID=
VITE_SQUARE_ENVIRONMENT=sandbox

# Server-only secrets for Supabase Edge Functions (never use VITE_ prefix)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SITE_URL=https://leavoramarket.com
